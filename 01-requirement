#!/usr/bin/env bash
# Preflight: validate config, detect the OS family, check hardware, install base tools.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/setup.cfg"

# Set by detect-os; other scripts/steps can branch on these.
OS_FAMILY=""      # debian | redhat
PKG_MANAGER=""    # apt-get | dnf | yum

# Kubernetes needs ~2 GB, but a "2 GB" VM reports slightly less than 2048 MB
# (kernel/firmware reserve some). kubeadm's own preflight check uses 1700 MB.
MIN_RAM_MB=1700
MIN_CPUS=2

validate-config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "Missing ${CONFIG_FILE}. Create it with CONTAINERD_VERSION, RUNC_VERSION, CNI_VERSION and KUBE_VERSION." >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"

    # Report every missing value, then stop.
    local missing=0 var
    for var in CONTAINERD_VERSION RUNC_VERSION CNI_VERSION KUBE_VERSION; do
        if [[ -z "${!var:-}" ]]; then
            echo "Ensure setup.cfg contains ${var}=<version>  (e.g. ${var}=1.2.3)" >&2
            missing=1
        fi
    done
    (( missing == 0 )) || exit 1
}

detect-os() {
    # Debian first: Ubuntu/Mint/etc. all ship /etc/debian_version
    if [[ -f /etc/debian_version ]]; then
        OS_FAMILY="debian"
        PKG_MANAGER="apt-get"
        echo "Debian-based distribution detected"
    elif [[ -f /etc/redhat-release ]]; then
        OS_FAMILY="redhat"
        PKG_MANAGER="yum"
        command -v dnf >/dev/null 2>&1 && PKG_MANAGER="dnf"
        echo "Red Hat-based distribution detected"
    else
        echo "Unknown Linux distribution (neither /etc/debian_version nor /etc/redhat-release found)" >&2
        exit 1
    fi
}

check-privileges() {
    if [[ $EUID -ne 0 ]] && ! command -v sudo >/dev/null 2>&1; then
        echo "Run as root or install sudo." >&2
        exit 1
    fi
}

pkg-install() { # pkg-install <package>...
    case "$OS_FAMILY" in
        debian) sudo apt-get update && sudo apt-get install -y "$@" ;;
        redhat) sudo "$PKG_MANAGER" install -y "$@" ;;
    esac
}

install-prerequisites() {
    # Package names match the command names on both families (gpg ships in "gnupg" on Debian).
    local pkgs=() cmd
    for cmd in curl wget tar; do
        command -v "$cmd" >/dev/null 2>&1 || pkgs+=("$cmd")
    done
    if [[ "$OS_FAMILY" == "debian" ]]; then
        command -v gpg >/dev/null 2>&1 || pkgs+=("gnupg")
    fi

    if (( ${#pkgs[@]} > 0 )); then
        echo "Installing missing tools: ${pkgs[*]}"
        pkg-install "${pkgs[@]}"
    else
        echo "Base tools already installed"
    fi
}

check-requirement() {
    local total_memory cpu_count
    total_memory=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo)
    cpu_count=$(nproc)

    if (( total_memory >= MIN_RAM_MB )); then
        echo "RAM OK: ${total_memory} MB (minimum ${MIN_RAM_MB} MB)"
    else
        echo "Error: ${total_memory} MB RAM; at least ${MIN_RAM_MB} MB (~2 GB) required" >&2
        exit 2
    fi

    if (( cpu_count >= MIN_CPUS )); then
        echo "CPU OK: ${cpu_count} CPUs (minimum ${MIN_CPUS})"
    else
        echo "Error: ${cpu_count} CPU(s); at least ${MIN_CPUS} required" >&2
        exit 2
    fi
}

main() {
    validate-config
    detect-os
    check-privileges
    check-requirement
    install-prerequisites
    echo "Requirement passed"
}

main "$@"